{
	"useTabs": true,
	"tabWidth": 2,
	"printWidth": 80,
	"endOfLine": "lf",
	"arrowParens": "always",
	"bracketSameLine": false,
	"bracketSpacing": true,
	"jsxSingleQuote": false,
	"quoteProps": "as-needed",
	"semi": false,
	"trailingComma": "all",
	"singleQuote": false,
	"plugins": ["prettier-plugin-organize-imports"]
}
