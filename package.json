{
	"engines": {
		"node": ">=22.0.0"
	},
	"name": "rest-api-crud",
	"version": "1.3.0",
	"description": "",
	"type": "module",
	"main": "server.js",
	"scripts": {
		"dev": "tsx --env-file=.env.development --env-file=.env api/server.ts",
		"build": "tsc",
		"start": "node --env-file=.env.production --env-file=.env dist/server.js",
		"seed": "prisma db push --accept-data-loss && ts-node prisma/seed.ts",
		"export:csv": "ts-node prisma/exportCSV.ts",
		"test:run": "tsx --test --test-concurrency=1 'api/**/*.test.ts'",
		"test:watch": "tsx --test --watch --test-concurrency=1 'api/**/*.test.ts'",
		"test": "bash -lc 'set -a; [ -f .env ] && source .env; [ -f .env.test ] && source .env.test; set +a; npx prisma migrate deploy && tsx --test --test-concurrency=1 \"api/**/*.test.ts\"'",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"docker:build-dev": "docker compose -f docker-compose.dev.yml build --build-arg BUILD=1",
		"docker:up-dev": "docker compose -f docker-compose.dev.yml up",
		"docker:down-dev": "docker compose -f docker-compose.dev.yml down",
		"docker:build-prod": "docker compose -f docker-compose.prod.yml build --build-arg BUILD=1",
		"docker:up-prod": "docker compose -f docker-compose.prod.yml up -d",
		"docker:down-prod": "docker compose -f docker-compose.prod.yml down"
	},
	"keywords": [
		"rest",
		"api",
		"crud"
	],
	"author": "Emiliano Sasal",
	"license": "ISC",
	"dependencies": {
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@prisma/client-runtime-utils": "^7.9.1",
		"bcrypt": "^6.0.0",
		"cookie-parser": "^1.4.7",
		"cors": "^2.8.6",
		"dotenv": "17.4.2",
		"express": "^5.2.1",
		"express-validator": "^7.3.2",
		"helmet": "^8.3.0",
		"ioredis": "^5.11.1",
		"jsonwebtoken": "^9.0.3",
		"morgan": "^1.11.0",
		"rate-limiter-flexible": "^11.2.0",
		"swagger-jsdoc": "^6.3.0",
		"swagger-ui-express": "^5.0.1"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bcrypt": "^6.0.0",
		"@types/cookie-parser": "^1.4.10",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.6",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/morgan": "^1.9.10",
		"@types/node": "^22.20.1",
		"@types/supertest": "^7.2.1",
		"@types/swagger-jsdoc": "^6.0.4",
		"@types/swagger-ui-express": "^4.1.8",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"globals": "^17.9.0",
		"ioredis-mock": "^8.13.1",
		"pnpm": "^11.20.0",
		"prettier": "^3.9.6",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prisma": "^7.9.1",
		"supertest": "^7.2.2",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsx": "4.23.11",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0"
	}
}
